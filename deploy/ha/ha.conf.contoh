# =============================================================================
#  Konfigurasi server utama + cadangan (CBT HA)
#  Salin menjadi ha.conf di KEDUA server. Isinya harus SAMA PERSIS.
#  Setelah skrip dijalankan, salinan aman disimpan di /etc/cbt-ha/ha.conf.
# =============================================================================

# Alamat masing-masing server. Siswa memakai alamat utama. Bila server utama
# rusak dan cadangan dipindah menjadi utama, siswa diberi tahu alamat cadangan.
#  - VPS + Cloudflare: isi domain (DNS Proxied / awan oranye) -> https
#  - Jaringan lokal sekolah: isi IP server, mis. 172.16.32.154 -> http biasa,
#    tanpa sertifikat Cloudflare
DOMAIN_UTAMA="utama.sekolah.sch.id"
DOMAIN_CADANGAN="cadangan.sekolah.sch.id"

# IP kedua server. Tiga pola:
#  - Dua VPS            : dua IP publik -> WireGuard
#  - Dua server sekolah : dua IP LAN    -> langsung, tanpa WireGuard
#  - Campuran (utama di sekolah, cadangan di VPS):
#      UTAMA_IP="172.16.32.154"  (IP LAN), CADANGAN_IP="<IP publik VPS>"
#      -> WireGuard; server sekolah yang menghubungi VPS (tidak perlu buka port
#         di router sekolah), VPS cukup membuka UDP 51820.
#      DOMAIN_UTAMA boleh IP LAN (http) dan DOMAIN_CADANGAN domain Cloudflare (https).
#      Selama domain belum ada, DOMAIN_CADANGAN boleh diisi IP publik VPS (http, hanya untuk uji coba).
UTAMA_IP=""
CADANGAN_IP=""

# Rahasia bersama kedua server (kunci WireGuard, password replikasi, password rsync).
# Buat sekali dengan:  openssl rand -hex 32
HA_SECRET=""

# Backup (disimpan di server cadangan, /var/backups/cbt)
BACKUP_KEEP_DAYS=7        # simpan berapa hari
BACKUP_JAM_UJIAN="6-17"   # jam backup database tiap 15 menit (format jam cron)

# HTTPS lewat Cloudflare Proxied (awan oranye) + sertifikat Origin: ya | tidak (http biasa, DNS only).
# Kosong: IP -> http, domain -> https.
PAKAI_HTTPS="tidak"
