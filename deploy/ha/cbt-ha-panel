#!/usr/bin/env php
<?php
/**
 * Jembatan root untuk menu Admin Tools → Server Cadangan di CBT Admin.
 * Dipasang install.sh ke /usr/local/sbin/cbt-ha-panel; www-data boleh menjalankannya lewat sudo
 * (/etc/sudoers.d/cbtadmin-ha) HANYA dengan argumen di bawah ini.
 *
 *   cbt-ha-panel status   → JSON: peran server, alamat, koneksi, replikasi, salinan file, backup
 *   cbt-ha-panel pindah   → jalankan "ha-cadangan.sh pindah" di latar belakang (hanya di server cadangan)
 *   cbt-ha-panel log      → JSON: isi log pindah terakhir + apakah masih berjalan
 *   cbt-ha-panel kembalikan → jalankan "ha-utama.sh kembalikan" di latar belakang (hanya di server utama yang nonaktif)
 *   cbt-ha-panel utama    → "cbt-ha utama" di latar belakang: mode sinkron di server utama (tombol di panel)
 *   cbt-ha-panel cadangan → KODE dari stdin (bukan argumen, supaya kunci rahasia tidak terlihat di daftar proses),
 *                           simpan ha.conf lalu "ha-cadangan.sh pasang" di latar belakang
 */

const HA_DIR    = '/etc/cbt-ha';
const ROLE_FILE = '/etc/cbt-ha-peran';
const SKRIP     = '/usr/local/share/cbt-ha/ha-cadangan.sh';
const SKRIP_UTAMA = '/usr/local/share/cbt-ha/ha-utama.sh';
const LOG_FILE  = '/var/log/cbt-ha-pindah.log';
const PID_FILE  = '/run/cbt-ha-pindah.pid';
const HASIL_FILE = '/var/lib/cbt-ha-panel.hasil';   // kode keluar proses latar terakhir
const AKSI_FILE  = '/var/lib/cbt-ha-panel.aksi';    // jenis proses latar terakhir (pindah|kembalikan|utama|cadangan)
const BACKUP    = '/var/backups/cbt/db';
const CBT_HA    = '/usr/local/sbin/cbt-ha';

function keluar(array $data, int $kode = 0): never
{
    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    exit($kode);
}

function jalan(string $cmd): string
{
    return trim((string) shell_exec('{ ' . $cmd . '; } 2>/dev/null'));
}

/** Nilai ha.conf (format VAR="nilai"); HA_SECRET tidak pernah dikirim ke panel. */
function bacaConf(): array
{
    $conf = [];
    $file = HA_DIR . '/ha.conf';
    if (! is_file($file)) {
        return $conf;
    }
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $baris) {
        if (preg_match('/^\s*([A-Z_]+)=["\']?([^"\'#]*)["\']?/', $baris, $m) && $m[1] !== 'HA_SECRET') {
            $conf[$m[1]] = trim($m[2]);
        }
    }

    return $conf;
}

function berjalan(): bool
{
    $pid = (int) @file_get_contents(PID_FILE);

    return $pid > 0 && file_exists('/proc/' . $pid);
}

/** Jumlah percobaan ujian yang sedang dikerjakan siswa (null bila database Moodle tidak terbaca). */
function ujianBerjalan(): ?int
{
    $cfg = (string) @file_get_contents('/var/www/moodle/config.php');
    if (! preg_match("/\\\$CFG->dbname\\s*=\\s*'([A-Za-z0-9_]+)'/", $cfg, $db) || ! preg_match("/\\\$CFG->prefix\\s*=\\s*'([A-Za-z0-9_]*)'/", $cfg, $pf)) {
        return null;
    }
    $n = jalan('mariadb -N -B -e ' . escapeshellarg("SELECT COUNT(*) FROM `{$db[1]}`.`{$pf[1]}quiz_attempts` WHERE state = 'inprogress'"));

    return ctype_digit($n) ? (int) $n : null;
}

/**
 * Proses latar belakang (setsid, tetap jalan walau halaman ditutup); catatan ke LOG_FILE. Saat selesai, kode keluar
 * ditulis ke HASIL_FILE (bersama jenis aksi di AKSI_FILE) supaya panel bisa menampilkan berhasil/gagal.
 */
function mulaiLatar(string $aksi, string $judul, string $cmd): never
{
    @unlink(HASIL_FILE);
    file_put_contents(AKSI_FILE, $aksi);
    file_put_contents(LOG_FILE, '[' . date('Y-m-d H:i:s') . '] ' . $judul . "\n");
    $dalam = $cmd . '; echo $? > ' . escapeshellarg(HASIL_FILE);
    $pid   = jalan('YES=1 setsid nohup bash -c ' . escapeshellarg($dalam) . ' >> ' . escapeshellarg(LOG_FILE) . ' 2>&1 < /dev/null & echo $!');
    file_put_contents(PID_FILE, $pid);
    keluar(['ok' => true, 'pid' => (int) $pid]);
}

/**
 * Hasil proses terakhir: null selama berjalan / belum pernah. ok = kode keluar 0 (untuk cadangan juga replikasi
 * berjalan), pesan = baris [GAGAL]/[PERINGATAN] terakhir di catatan bila gagal.
 */
function hasilTerakhir(): ?array
{
    if (berjalan() || ! is_file(LOG_FILE)) {
        return null;
    }
    $log = preg_replace('/\e\[[0-9;]*m/', '', (string) @file_get_contents(LOG_FILE));
    if (is_file(HASIL_FILE)) {
        $kode = (int) trim((string) file_get_contents(HASIL_FILE));
        $aksi = trim((string) @file_get_contents(AKSI_FILE));
    } else {
        // Proses dari versi lama (tanpa berkas hasil): disimpulkan dari catatannya.
        $awal = strtok($log, "\n") ?: '';
        $aksi = str_contains($awal, 'mode sinkron') ? 'utama' : (str_contains($awal, 'server cadangan') ? 'cadangan'
            : (str_contains($awal, 'kembalikan') ? 'kembalikan' : (str_contains($awal, 'pindah') ? 'pindah' : '')));
        if (str_contains($log, '[GAGAL]')) {
            $kode = 1;
        } elseif (preg_match('/\bSIAP\b|SELESAI|BERHASIL/', $log)) {
            $kode = 0;
        } else {
            return null;
        }
    }
    $pesan = '';
    if ($kode !== 0 && preg_match_all('/^\[GAGAL\]\s*(.+(?:\n(?!\[|==>).+)*)/m', $log, $m)) {
        $pesan = trim(end($m[1]));
    } elseif ($kode !== 0) {
        $baris = array_values(array_filter(array_map('trim', explode("\n", $log))));
        $pesan = (string) end($baris);
    }
    $ok = $kode === 0;
    if ($ok && $aksi === 'cadangan') {
        // Terpasang belum tentu terhubung: pastikan salinan database dari server utama berjalan sekarang.
        $sl = jalan('mariadb -e "SHOW SLAVE STATUS\G"');
        $io = preg_match('/^\s*Slave_IO_Running:\s*(\S+)/m', $sl, $a) ? $a[1] : '';
        $sq = preg_match('/^\s*Slave_SQL_Running:\s*(\S+)/m', $sl, $b) ? $b[1] : '';
        if ($io !== 'Yes' || $sq !== 'Yes') {
            $ok    = false;
            $err   = preg_match('/^\s*Last_IO_Error:\s*(.+)$/m', $sl, $c) ? trim($c[1]) : '';
            $pesan = 'Terpasang, tetapi salinan database dari server utama tidak berjalan (IO: ' . ($io ?: '-') . ', SQL: ' . ($sq ?: '-') . ')'
                . ($err !== '' ? ': ' . $err : '.');
        }
    }

    return ['aksi' => $aksi, 'kode' => $kode, 'ok' => $ok, 'pesan' => mb_substr($pesan, 0, 600), 'waktu' => (int) filemtime(is_file(HASIL_FILE) ? HASIL_FILE : LOG_FILE)];
}

$aksi = $argv[1] ?? '';

if ($aksi === 'status') {
    $conf  = bacaConf();
    $peran = is_file(ROLE_FILE) ? trim((string) file_get_contents(ROLE_FILE)) : '';
    // Jenis server = cara dipasang (cron cbt-ha-cadangan hanya ada di server yang dipasang sebagai cadangan), tetap
    // walau perannya berubah (cadangan setelah PINDAH berperan utama, saat dikembalikan berperan nonaktif).
    $jenis = is_file('/etc/cron.d/cbt-ha-cadangan') ? 'cadangan' : 'utama';
    // PAKAI_HTTPS di ha.conf menang; tanpa itu: IP → http, domain → https (sama seperti ha-*.sh).
    $https = $conf['PAKAI_HTTPS'] ?? '';
    $skema = static fn (string $h): string => $h === '' ? '' : (($https !== '' ? $https === 'ya' : ! preg_match('/^[0-9.]+$/', $h)) ? 'https://' : 'http://') . $h;

    // Kontak ke server lain: lewat WireGuard (handshake terakhir) atau ping IP pasangan.
    $peerIp  = $jenis === 'cadangan' ? '10.77.0.1' : '10.77.0.2';
    $kontak  = null;
    $adaWg   = jalan('ip link show wg-cbt >/dev/null && echo ya') === 'ya';
    $hs      = (int) jalan("wg show wg-cbt latest-handshakes | awk '{print \$2}' | head -1");
    if ($hs > 0) {
        $kontak = time() - $hs;
    } elseif (! $adaWg && $peran !== '') {
        // Tanpa WireGuard (kedua server di LAN): cukup ping. Dengan WireGuard, hanya handshake yang dihitung;
        // ping ke IP publik VPS bisa berhasil walau terowongan belum tersambung.
        $peer = $jenis === 'cadangan' ? ($conf['UTAMA_IP'] ?? '') : ($conf['CADANGAN_IP'] ?? '');
        foreach (array_filter([$peerIp, $peer]) as $ip) {
            if (jalan('ping -c1 -W2 ' . escapeshellarg($ip) . ' >/dev/null && echo ok') === 'ok') {
                $kontak = 0;
                break;
            }
        }
    }
    // Terhubung SEKARANG: ping lewat terowongan (atau IP LAN pasangan). Handshake WireGuard hanya diperbarui ±2 menit
    // sekali, jadi umurnya tidak cukup cepat menandai server pasangan yang baru mati.
    $sasaran   = $adaWg ? $peerIp : ($jenis === 'cadangan' ? ($conf['UTAMA_IP'] ?? '') : ($conf['CADANGAN_IP'] ?? ''));
    $terhubung = $sasaran !== '' && $peran !== ''
        && jalan('ping -c2 -i0.3 -W1 ' . escapeshellarg($sasaran) . ' >/dev/null && echo ok') === 'ok';

    // Replikasi database (hanya di server cadangan).
    $repl = null;
    $sl   = jalan('mariadb -e "SHOW SLAVE STATUS\G"');
    if ($sl !== '') {
        $f = static function (string $k) use ($sl): string {
            return preg_match('/^\s*' . $k . ':\s*(.*)$/m', $sl, $m) ? trim($m[1]) : '';
        };
        $repl = [
            'io'    => $f('Slave_IO_Running'),
            'sql'   => $f('Slave_SQL_Running'),
            'lag'   => $f('Seconds_Behind_Master'),
            'error' => trim($f('Last_IO_Error') . ' ' . $f('Last_SQL_Error')),
        ];
    }

    $sync = is_file(HA_DIR . '/sync-terakhir') ? time() - (int) file_get_contents(HA_DIR . '/sync-terakhir') : null;

    $backup = [];
    foreach (array_slice(glob(BACKUP . '/*.sql.gz') ?: [], -3) as $b) {
        $backup[] = ['file' => basename($b), 'ukuran' => filesize($b), 'waktu' => filemtime($b)];
    }
    $backup = array_reverse($backup);

    keluar([
        'ok'              => true,
        'terpasang'       => $conf !== [],
        'peran'           => $peran,
        'jenis'           => $jenis,
        'domain_utama'    => $conf['DOMAIN_UTAMA'] ?? '',
        'domain_cadangan' => $conf['DOMAIN_CADANGAN'] ?? '',
        'url_utama'       => $skema($conf['DOMAIN_UTAMA'] ?? ''),
        'url_cadangan'    => $skema($conf['DOMAIN_CADANGAN'] ?? ''),
        'utama_ip'        => $conf['UTAMA_IP'] ?? '',
        'cadangan_ip'     => $conf['CADANGAN_IP'] ?? '',
        'kontak_detik'    => $kontak,
        'terhubung'       => $terhubung,
        'replikasi'       => $repl,
        'sync_detik'      => $sync,
        'backup'          => $backup,
        'disk_kosong'     => is_dir(dirname(BACKUP)) ? (int) disk_free_space(dirname(BACKUP)) : null,
        'pindah_berjalan' => berjalan(),
        'hasil'           => hasilTerakhir(),
    ]);
}

if ($aksi === 'pindah') {
    if (trim((string) @file_get_contents(ROLE_FILE)) !== 'cadangan') {
        keluar(['ok' => false, 'error' => 'Server ini bukan server cadangan.'], 1);
    }
    if (! is_file(SKRIP)) {
        keluar(['ok' => false, 'error' => 'Skrip ' . SKRIP . ' tidak ada. Jalankan deploy ulang.'], 1);
    }
    if (berjalan()) {
        keluar(['ok' => false, 'error' => 'Proses pindah/kembalikan sudah berjalan (tombol cukup diklik sekali). Muat ulang halaman ini untuk melihat catatannya.'], 1);
    }
    // Server utama masih menjawab (lewat WireGuard atau LAN) → tolak, supaya jawaban siswa tidak bercabang.
    $conf = bacaConf();
    $utama = jalan('ip link show wg-cbt >/dev/null 2>&1 && echo ya') === 'ya' ? '10.77.0.1' : (string) ($conf['UTAMA_IP'] ?? '');
    if ($utama !== '' && jalan('ping -c3 -i0.5 -W2 ' . escapeshellarg($utama) . ' >/dev/null 2>&1 && echo ok') === 'ok') {
        keluar(['ok' => false, 'error' => 'Server utama masih terhubung, jadi pindah ditolak supaya jawaban siswa tidak bercabang. '
            . 'Matikan server utama atau putuskan jaringannya dulu, lalu ulangi.'], 1);
    }
    mulaiLatar('pindah', 'Mulai pindah dari panel CBT Admin', 'bash ' . escapeshellarg(SKRIP) . ' pindah');
}

if ($aksi === 'kembalikan') {
    // Server utama nonaktif → ambil data terbaru dari server cadangan lalu aktif lagi (ha-utama.sh kembalikan).
    if (trim((string) @file_get_contents(ROLE_FILE)) !== 'nonaktif') {
        keluar(['ok' => false, 'error' => 'Kembalikan hanya untuk server utama yang sedang nonaktif.'], 1);
    }
    if (is_file('/etc/cron.d/cbt-ha-cadangan')) {
        keluar(['ok' => false, 'error' => 'Server ini server cadangan: tombol Kembalikan dipakai di panel server utama.'], 1);
    }
    if (! is_file(SKRIP_UTAMA)) {
        keluar(['ok' => false, 'error' => 'Skrip ' . SKRIP_UTAMA . ' tidak ada. Jalankan cbt-perbarui.'], 1);
    }
    if (berjalan()) {
        keluar(['ok' => false, 'error' => 'Proses lain sedang berjalan.'], 1);
    }
    $conf     = bacaConf();
    $cadangan = jalan('ip link show wg-cbt >/dev/null 2>&1 && echo ya') === 'ya' ? '10.77.0.2' : (string) ($conf['CADANGAN_IP'] ?? '');
    $peran    = $cadangan === '' ? '' : jalan('curl -fsS --max-time 5 ' . escapeshellarg('http://' . $cadangan . '/cbt-ha-peran') . " | tr -d '[:space:]'");
    if ($peran !== 'utama') {
        keluar(['ok' => false, 'error' => 'Server cadangan tidak sedang dipakai ujian atau tidak terjangkau (peran: ' . ($peran ?: 'tidak terjangkau')
            . '). Pastikan server cadangan hidup dan sudah cbt-perbarui.'], 1);
    }
    mulaiLatar('kembalikan', 'Mulai kembalikan dari panel CBT Admin', 'bash ' . escapeshellarg(SKRIP_UTAMA) . ' kembalikan');
}

if ($aksi === 'utama') {
    // Mode sinkron di server utama = "cbt-ha utama" (ha.conf dari pengaturan panel, lalu ha-utama.sh pasang).
    $peran = trim((string) @file_get_contents(ROLE_FILE));
    if (is_file('/etc/cron.d/cbt-ha-cadangan') || $peran === 'cadangan') {
        keluar(['ok' => false, 'error' => 'Server ini dipasang sebagai server cadangan. Tombol ini dipakai di panel server utama.'], 1);
    }
    if ($peran === 'nonaktif' || $peran === 'kembali') {
        keluar(['ok' => false, 'error' => 'Server ini sedang nonaktif (ujian dilayani server cadangan). Pakai tombol Kembalikan.'], 1);
    }
    if (! is_file(CBT_HA) || ! is_file(SKRIP_UTAMA)) {
        keluar(['ok' => false, 'error' => 'Skrip HA belum terpasang. Jalankan cbt-perbarui di server ini.'], 1);
    }
    if (berjalan()) {
        keluar(['ok' => false, 'error' => 'Proses lain sedang berjalan. Tunggu sampai selesai.'], 1);
    }
    // Pemasangan bisa me-restart MariaDB (binlog), jadi ditolak saat siswa sedang mengerjakan.
    $n = ujianBerjalan();
    if ($n > 0) {
        keluar(['ok' => false, 'error' => $n . ' siswa sedang mengerjakan ujian. Aktifkan mode sinkron setelah ujian selesai.'], 1);
    }
    mulaiLatar('utama', 'Mulai mode sinkron (cbt-ha utama) dari panel CBT Admin', escapeshellarg(CBT_HA) . ' utama');
}

if ($aksi === 'cadangan') {
    // Jadikan server ini cadangan: KODE (base64 ha.conf dari panel server utama) dibaca dari stdin.
    $kode = trim((string) stream_get_contents(STDIN, 16384));
    $kode = preg_replace('/^cbt-ha\s+cadangan\s+/', '', $kode);  // boleh menempel perintah lengkapnya
    $kode = preg_replace('/\s+/', '', (string) $kode);
    $isi  = preg_match('#^[A-Za-z0-9+/]+={0,2}$#', $kode) ? base64_decode($kode, true) : false;
    if (! is_string($isi) || ! preg_match('/^HA_SECRET="[A-Za-z0-9]{32,}"$/m', $isi)
        || ! preg_match('/^UTAMA_IP="[0-9.]+"$/m', $isi) || ! preg_match('/^CADANGAN_IP="[0-9.]+"$/m', $isi)) {
        keluar(['ok' => false, 'error' => 'KODE tidak valid. Salin ulang seluruh KODE dari menu Server Cadangan di panel server utama.'], 1);
    }
    // Hanya baris VAR="nilai" yang dikenal; ha.conf di-source oleh skrip bash sebagai root.
    $baris = [];
    foreach (explode("\n", $isi) as $b) {
        $b = rtrim($b, "\r");
        if ($b === '' || str_starts_with($b, '#')) {
            continue;
        }
        if (! preg_match('/^[A-Z_]+="[A-Za-z0-9.:_-]*"$/', $b)) {
            keluar(['ok' => false, 'error' => 'KODE berisi baris yang tidak dikenal. Salin ulang dari panel server utama.'], 1);
        }
        $baris[] = $b;
    }
    $peran = trim((string) @file_get_contents(ROLE_FILE));
    if ($peran === 'utama' || $peran === 'nonaktif' || $peran === 'kembali') {
        keluar(['ok' => false, 'error' => 'Server ini sedang berperan ' . strtoupper($peran) . '. Hanya server baru atau server cadangan yang bisa dipasang sebagai cadangan.'], 1);
    }
    if (! is_file(SKRIP)) {
        keluar(['ok' => false, 'error' => 'Skrip HA belum terpasang. Jalankan cbt-perbarui di server ini.'], 1);
    }
    if (berjalan()) {
        keluar(['ok' => false, 'error' => 'Proses lain sedang berjalan. Tunggu sampai selesai.'], 1);
    }
    if (! is_dir(HA_DIR)) {
        mkdir(HA_DIR, 0700, true);
    }
    file_put_contents(HA_DIR . '/ha.conf', '# Konfigurasi CBT HA (dari KODE panel server utama, ' . date('Y-m-d H:i') . ").\n" . implode("\n", $baris) . "\n");
    chmod(HA_DIR . '/ha.conf', 0600);
    mulaiLatar('cadangan', 'Mulai pasang server cadangan dari panel CBT Admin', 'flock -n /run/cbt-ha-pasang.lock bash ' . escapeshellarg(SKRIP) . ' pasang');
}

if ($aksi === 'log') {
    $isi = is_file(LOG_FILE) ? (string) file_get_contents(LOG_FILE) : '';
    $isi = preg_replace('/\e\[[0-9;]*m/', '', $isi);  // buang kode warna terminal
    keluar(['ok' => true, 'berjalan' => berjalan(), 'hasil' => hasilTerakhir(), 'log' => mb_substr($isi, -20000)]);
}

keluar(['ok' => false, 'error' => 'Pakai: cbt-ha-panel status | pindah | kembalikan | utama | cadangan | log'], 1);
